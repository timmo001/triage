{
  "config": {
    "default": true,
    "MD013": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    ".agents/**",
    // A symlink to .agents/skills, for Claude Code.
    ".claude/skills/**",
    // Copied as-is from the latest GitHub release notes by the Release workflow.
    "home-assistant/app/CHANGELOG.md",
  ],
}

{
  "name": "@timmo001/effect-triage",
  "version": "0.12.0",
  "description": "Effect schemas and protocol for triage, which captures crashes and errors and decides which are worth fixing",
  "keywords": [
    "effect",
    "triage",
    "crashes",
    "logs"
  ],
  "homepage": "https://github.com/timmo001/triage/tree/main/packages/effect-triage#readme",
  "bugs": {
    "url": "https://github.com/timmo001/triage/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/triage.git",
    "directory": "packages/effect-triage"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "effect": "4.0.1"
  },
  "devDependencies": {
    "effect": "4.0.1"
  }
}

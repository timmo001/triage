[Unit]
Description=triage worker, deciding on issues and suggesting fixes for a server
Documentation=https://github.com/timmo001/triage
After=network-online.target
Wants=network-online.target
# Needs TRIAGE_SERVER, TRIAGE_WORKER_TOKEN from `triage workers add` on the
# server, and TRIAGE_DECIDE, TRIAGE_SUGGEST or both.
ConditionPathExists=%h/.config/triage/worker.env

[Service]
Type=simple
EnvironmentFile=%h/.config/triage/worker.env
ExecStart=/usr/bin/triage work
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
